# No secrets, paid APIs, or environment variables are required.
# Optional: set in your shell before starting the backend to use a different
# trusted MediaPipe pose_landmarker_lite.task file. .env is not auto-loaded.
# POSE_MODEL_PATH=/absolute/path/to/pose_landmarker_lite.task
# Optional local classifier directory (the launcher downloads it automatically):
# APPEARANCE_MODEL_DIR=/absolute/path/to/.local/appearance
# Development/test only: LITTLE_FIGURES_FRONTEND_PORT=5173
# Development/test only: LITTLE_FIGURES_BACKEND_PORT=8000
# Tests only: CHROMIUM_PATH=/path/to/chromium

# Optional verified model paths for the photo-first flow:
# PEOPLE_MODEL_PATH=/absolute/path/to/.local/people/yolox-s-int8.onnx
# GARMENT_MODEL_DIR=/absolute/path/to/.local/garment
